let fruits = ["Banana", "Apple", "Cherry"];
fruits.sort();
console.log(fruits);

// alphabetical by default

let score = [4, 3, 2];
console.log(score.sort());

let nums = [10, 1, 21, 2];
nums.sort();
console.log(nums);

nums.sort((a,b) => a-b);
console.log(nums);

nums.reverse();
console.log(nums);

fruits.reverse();
console.log(fruits);